<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/white"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <!-- Home Tab -->
    <FrameLayout
        android:id="@+id/navHomeContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvNavHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/nav_home"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Order Tab -->
    <FrameLayout
        android:id="@+id/navOrderContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvNavOrder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/nav_order"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Profile Tab -->
    <FrameLayout
        android:id="@+id/navProfileContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvNavProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/nav_profile"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>